rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'msg.designstudio.sg@gmail.com';
    }

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'category', 'imageUrl', 'createdAt', 'order', 'images']) &&
             data.title is string && data.title.size() <= 200 &&
             data.category is string &&
             data.imageUrl is string &&
             data.order is number &&
             data.images is list &&
             (data.keys().hasAny(['description']) ? data.description is string : true) &&
             (data.keys().hasAny(['updatedAt']) ? true : true);
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProject(request.resource.data);
      allow update: if isAdmin() && isValidProject(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
